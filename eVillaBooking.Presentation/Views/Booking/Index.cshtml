@model IEnumerable<Booking>

<div class="container py-4">
    <div class="card shadow-lg">
        <div class="card-header bg-gradient bg-success text-white text-center">
            <h4 class="mb-0">Amenity List</h4>
        </div>
        <div class="card-body">

            <div class="table-responsive">
                <table id="bookingTable" class="table table-hover table-striped table-bordered align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Check In</th>
                            <th>Nights</th>
                            <th>Villa Name</th>
                            <th>Total</th>
                            <th>Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                          
                       
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/booking.js"></script>
}