@model Booking

<div class="container pt-4 mt-0 mt-lg-4">
    <div class="row" style="border: 1px solid #aaa;">

        <!-- Left Column: Villa Details -->
        <div class="col-12 col-lg-7 p-4 mt-4 mt-md-0">
            <div class="row p-1 my-1" style="border-radius:20px;">
                <div class="col-6">
                    <h3 class="text-success">Villa Details</h3>
                </div>
                <div class="text-end col-6">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-danger" style="width:200px;">
                        <i class="bi bi-arrow-left-square"></i> &nbsp; Modify Selection
                    </a>
                </div>

                <hr />
                <partial name="_VillaDetails" model="@Model.Villa" />
                <hr />

                <div class="text-end">
                    <h4 class="text-danger font-weight-bold">
                        Booking Total :
                        <span style="border-bottom:1px solid #ff6a00">
                            @Model.TotalCost
                        </span>
                    </h4>
                </div>
            </div>
        </div>

        <!-- Right Column: Booking Form -->
        <div class="col-12 col-lg-5 p-4 mt-4 mt-md-0" style="border-left:1px solid #aaa">
            <form method="post">
                <!-- Hidden Fields (Needed in POST) -->
                <input asp-for="CheckOutDate" hidden />
                <input asp-for="UserId" hidden />
                @* <input asp-for="VillaId" hidden /> <!-- Added if needed --> *@
                <!-- Optional Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row pt-1 mb-3">
                    <div class="col-12">
                        <h3 class="text-success">Enter Booking Details</h3>
                    </div>
                </div>

                <div class="form-group pt-0">
                    <label asp-for="Name" class="text-warning">Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group pt-2">
                    <label asp-for="Phone" class="text-warning">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="form-group pt-2">
                    <label asp-for="Email" class="text-warning">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group pt-2">
                    <label asp-for="Nights" class="text-warning">No. of nights</label>
                    <input class="form-control" value="@Model.Nights" disabled />
                    <!-- Disabled input won't be posted; value shown just for display -->
                    <input asp-for="Nights" type="hidden" /> <!-- Added for submission -->
                </div>

                <div class="form-group pt-2">
                    <label asp-for="CheckInDate" class="text-warning">Check in Date</label>
                    <input class="form-control" value="@Model.CheckInDate.ToShortDateString()" disabled />
                    <input asp-for="CheckInDate" type="hidden" /> <!-- For submission -->
                </div>

                <div class="form-group pt-2">
                    <label asp-for="CheckOutDate" class="text-warning">Check Out Date</label>
                    <input class="form-control" value="@Model.CheckOutDate.ToShortDateString()" disabled />
                    <!-- Hidden already added at the top -->
                </div>

                <div class="form-group pt-2 pt-md-4">
                    @if (Model.Villa.IsAvailable)
                    {
                        <button type="submit" class="btn btn-success form-control">
                            Looks Good! Checkout Now
                        </button>
                    }
                    else
                    {
                        <input class="btn btn-danger disabled form-control" value="Sold Out" />
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
